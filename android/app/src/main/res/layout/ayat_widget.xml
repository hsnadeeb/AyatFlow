<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Header: Language toggles + Surah name + ayah number chip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <!-- Language audio toggles -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start">

            <TextView
                android:id="@+id/arabic_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Arabic"
                android:textColor="#2BB5A5"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/ayah_chip_background"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/english_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="English"
                android:textColor="#2BB5A5"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/ayah_chip_background"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/surah_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Al-Faatiha"
            android:textColor="#9BA1A6"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.14"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/ayah_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ayat 1"
            android:textColor="#2BB5A5"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/ayah_chip_background"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Text block: flexible so it absorbs extra height and keeps the
         controls anchored at the bottom (responsive across widget sizes) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- Arabic text -->
        <TextView
            android:id="@+id/arabic_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ"
            android:textColor="#F2F1EC"
            android:textSize="17sp"
            android:textAlignment="textEnd"
            android:fontFamily="serif"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="6dp" />

        <!-- Translation -->
        <TextView
            android:id="@+id/translation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="In the name of Allah, the Entirely Merciful, the Especially Merciful."
            android:textColor="#9BA1A6"
            android:textSize="12sp"
            android:textAlignment="textStart"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- Playback controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="10dp">

        <ImageView
            android:id="@+id/previous_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_skip_previous"
            android:tint="#A8A8B0"
            android:padding="8dp"
            android:background="@drawable/control_button_background"
            android:contentDescription="Previous ayah" />

        <ImageView
            android:id="@+id/play_pause_button"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_play_arrow"
            android:tint="#FFFFFF"
            android:padding="14dp"
            android:background="@drawable/play_button_background"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:contentDescription="Play or pause" />

        <ImageView
            android:id="@+id/next_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_skip_next"
            android:tint="#A8A8B0"
            android:padding="8dp"
            android:background="@drawable/control_button_background"
            android:contentDescription="Next ayah" />
    </LinearLayout>

    <!-- Surah progress -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_bar"
        android:indeterminate="false"
        android:maxHeight="3dp"
        android:minHeight="3dp"
        android:layout_marginTop="12dp" />

</LinearLayout>
